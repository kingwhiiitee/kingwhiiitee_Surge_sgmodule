#!name= 小红书去水印去广告
#!desc= 去除图文/视频笔记、实况照片与评论区图片的下载水印，解除媒体保存限制；去除开屏广告、首页/关注/搜索信息流推广笔记、笔记下方带货与商业合作挂件，拦截广告资源、惊喜盒子、营销弹窗与搜索页广告横幅。需开启 MITM 并信任证书；如未生效请清除小红书缓存后重试。
#!author= kingwhiiitee

[Map Local]
# 广告拦截：Surge 的 URL Rewrite 不支持 reject-dict，改为本地返回空 JSON
# 广告资源、广告互动上报
^https?:\/\/(edith|www)\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/ data-type=text data="{}" status-code=200
^https?:\/\/(edith|www)\.xiaohongshu\.com\/api\/sns\/v\d\/tag\/ads_engage data-type=text data="{}" status-code=200
# 惊喜盒子、营销弹窗
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/surprisebox\/ data-type=text data="{}" status-code=200
^https?:\/\/(edith|www)\.xiaohongshu\.com\/api\/marketing\/box\/trigger data-type=text data="{}" status-code=200
# 搜索页广告横幅、首页运营横幅
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/search\/banner_list data-type=text data="{}" status-code=200
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/guide\/user_banner data-type=text data="{}" status-code=200
# 客户端叠加水印用的配置图，替换为 1px 透明 GIF 使水印无法生成
^https?:\/\/ci\.xiaohongshu\.com\/system_config\/watermark data-type=tiny-gif status-code=200

[Script]
# 去水印
小红书图片去水印 = type=http-response, pattern=^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d\/note\/(imagefeed|feed|live_photo\/save)(\?|$), script-path=https://raw.githubusercontent.com/kingwhiiitee/kingwhiiitee_Surge_sgmodule/main/Xiaohongshu/xiaohongshu_watermark.js, requires-body=true, timeout=60
小红书视频去水印 = type=http-response, pattern=^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d\/note\/(videofeed|video\/save)(\?|$), script-path=https://raw.githubusercontent.com/kingwhiiitee/kingwhiiitee_Surge_sgmodule/main/Xiaohongshu/xiaohongshu_watermark.js, requires-body=true, timeout=60
小红书评论区去水印 = type=http-response, pattern=^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d\/(note\/comment\/(list|sub_comments)|interaction\/comment\/video\/download)(\?|$), script-path=https://raw.githubusercontent.com/kingwhiiitee/kingwhiiitee_Surge_sgmodule/main/Xiaohongshu/xiaohongshu_watermark.js, requires-body=true, timeout=60

# 去广告
小红书开屏去广告 = type=http-response, pattern=^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/(splash_config|config)(\?|$), script-path=https://raw.githubusercontent.com/kingwhiiitee/kingwhiiitee_Surge_sgmodule/main/Xiaohongshu/xiaohongshu_adblock.js, requires-body=true, timeout=30
小红书信息流去推广 = type=http-response, pattern=^https?:\/\/(edith|rec)\.xiaohongshu\.com\/api\/sns\/v\d\/(homefeed|followfeed|search\/notes)(\?|$), script-path=https://raw.githubusercontent.com/kingwhiiitee/kingwhiiitee_Surge_sgmodule/main/Xiaohongshu/xiaohongshu_adblock.js, requires-body=true, timeout=30
小红书笔记挂件去推广 = type=http-response, pattern=^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/note\/widgets(\?|$), script-path=https://raw.githubusercontent.com/kingwhiiitee/kingwhiiitee_Surge_sgmodule/main/Xiaohongshu/xiaohongshu_adblock.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, rec.xiaohongshu.com, www.xiaohongshu.com, ci.xiaohongshu.com
