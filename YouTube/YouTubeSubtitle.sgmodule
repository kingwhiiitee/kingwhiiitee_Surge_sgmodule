#!name= YouTube AI双语字幕
#!desc= YouTube App 双语字幕：开启字幕后自动将每条字幕翻译并以"原文+译文"同屏显示，翻译由 AI 完成（DeepSeek / OpenAI 二选一）。需在 BoxJS 中订阅「YouTube AI双语字幕」并填写 API Key，订阅地址：https://raw.githubusercontent.com/kingwhiiitee/kingwhiiitee_Surge_sgmodule/main/YouTube/YouTubeSubtitle.boxjs.json 。服务商、API Key、Base URL、模型、目标语言、双语位置、翻译缓存均可在 BoxJS 调整。需开启 MITM 并信任证书；首次开启字幕时按视频长度等待数秒至数十秒完成翻译，之后命中缓存。App 内手动选择"自动翻译"语言时不处理；未配置 Key 或翻译失败时保持原字幕。
#!author= kingwhiiitee

[Script]
# 字幕轨道响应：srv3/xml 与 json3 两种格式均支持，逐行 AI 翻译后按原格式回写双语
YouTube双语字幕 = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext, script-path=https://raw.githubusercontent.com/kingwhiiitee/kingwhiiitee_Surge_sgmodule/main/YouTube/youtube_subtitle.js, requires-body=true, timeout=120

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com
